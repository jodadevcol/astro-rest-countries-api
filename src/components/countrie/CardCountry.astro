---
import type { CountryCard } from "@types-local/countries"

interface Props {
	country: CountryCard
}

const { country } = Astro.props
const { name, cca3, region, capital, population, flags } = country
---

<div class="h-full bg-white dark:bg-dark-100">
	<a
		href={`country/${cca3}`}
		class="group relative max-w-full"
		aria-label={`${name.common}'s page with details of this country'`}
	>
		<picture class="block overflow-hidden rounded-xl" transition:name=`flag-${cca3}`>
			<img
				src={flags.svg}
				alt={`Flag of ${name.common}`}
				class="aspect-video max-h-40 w-full object-cover transition-transform duration-300 ease-in-out group-hover:scale-105"
			/>
		</picture>
	</a>

	<div class="px-6 pb-10 pt-6 text-light-100 dark:text-white">
		<h2 class="mb-4 text-lg font-extrabold">{name.common}</h2>

		<div
			class="space-y-2 [&>div>span]:font-semibold [&>div]:text-sm [&>div]:font-light [&>div]:leading-4"
		>
			<div>
				<span>Population</span>: {population.toLocaleString()}
			</div>
			{
				region && (
					<div>
						<span>Region</span>: {region}
					</div>
				)
			}
			{
				capital && (
					<div>
						<span>Capital</span>: {capital}
					</div>
				)
			}
		</div>
	</div>
</div>
