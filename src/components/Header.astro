---
import MoonOutline from "@icons/MoonOutline.astro"
import MoonSolid from "@icons/MoonSolid.astro"
---

<header
	class="bg-white px-5 dark:bg-dark-100 lg:px-10"
	style="filter: drop-shadow(0px 2px 4px rgba(0, 0, 0, 0.03));"
	transition:persist
>
	<div class="mx-auto max-w-screen-xl py-6">
		<div class="flex items-center justify-between">
			<a
				href="/"
				class="block text-light-100 transition-opacity duration-300 ease-in-out hover:opacity-50 dark:text-white"
			>
				<span class="text-2xl font-extrabold">Where in the world?</span>
			</a>

			<div class="flex items-center justify-end gap-3">
				<button
					data-click-event="event/darkmode"
					class="inline-flex items-center space-x-2 text-light-100 dark:text-white"
				>
					<div class="">
						<MoonOutline />

						<MoonSolid />
					</div>

					<span class="font-semibold">Dark Mode</span>
				</button>

				<div class="h-4 w-[1px] bg-light-100 opacity-50 dark:bg-white"></div>

				<a
					class="size-5 text-dark-200 transition-opacity duration-300 ease-in-out hover:opacity-60 dark:text-light-300"
					href="https://github.com/jodadevcol/astro-rest-countries-api"
					target="_blank"
				>
					<svg
						role="img"
						viewBox="0 0 24 24"
						xmlns="http://www.w3.org/2000/svg"
						class="size-full"
						fill="currentColor"
					>
						<title>GitHub</title><path
							d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
						></path>
					</svg>
				</a>

				<a
					class="size-5 text-dark-200 transition-opacity duration-300 ease-in-out hover:opacity-60 dark:text-light-300"
					href="https://www.frontendmentor.io/challenges/rest-countries-api-with-color-theme-switcher-5cacc469fec04111f7b848ca/hub"
					target="_blank"
				>
					<svg
						role="img"
						viewBox="0 0 24 24"
						xmlns="http://www.w3.org/2000/svg"
						class="size-full"
						fill="currentColor"
					>
						<title>Frontend Mentor</title><path
							d="M12.1706 1.2719a.732.732 0 00-.7186.732v13.914a.732.732 0 00.732.732.732.732 0 00.7318-.732V2.004a.732.732 0 00-.7452-.732zm11.0741 4.1685a.7339.7339 0 00-.2764.063L16.686 8.307a.7329.7329 0 000 1.3361l6.2823 2.8134a.7378.7378 0 00.2993.0648.732.732 0 00.2973-1.401l-4.786-2.1443 4.786-2.1366a.7339.7339 0 00.3698-.9664.7339.7339 0 00-.69-.4327zm-22.499 5.032a.7316.7316 0 00-.7223.9149c1.736 6.677 7.7748 11.341 14.6822 11.341a.732.732 0 000-1.464 13.7055 13.7055 0 01-13.266-10.2449.7316.7316 0 00-.6939-.547z"
						></path>
					</svg>
				</a>
			</div>
		</div>
	</div>
</header>

<script>
	import { hasDarkMode, setDarkMode } from "@tools/dark-mode.ts"

	document.addEventListener("astro:after-swap", () => {
		setDarkMode({ isDark: hasDarkMode() })
	})

	document.addEventListener("astro:page-load", () => {
		setDarkMode({ isDark: hasDarkMode() })
		const darkModeButton = document.querySelector("[data-click-event='event/darkmode']")

		darkModeButton?.addEventListener("click", () => {
			document.documentElement.classList.toggle("dark")

			const containsDark = document.documentElement.classList.contains("dark")
			setDarkMode({ isDark: containsDark })
		})
	})

	setDarkMode({ isDark: hasDarkMode() })
</script>
