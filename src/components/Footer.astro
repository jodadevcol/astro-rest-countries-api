			<a
				class="transition-opacity duration-300 ease-in-out hover:opacity-60"
				href="https://www.frontendmentor.io/"
				target="_blank">Frontend Mentor</a
			>
		</span>

		<div class="mx-auto h-[1px] w-full max-w-[80%] grow bg-dark-100/10 dark:bg-light-200/10"></div>

		<span class="w-full grow text-center">{new Date().getFullYear()}, Built by Joda</span>
